{
	"name": "pi-web-search-lite",
	"version": "0.2.0",
	"description": "Pi extension: lightweight web_search + web_fetch with configurable search provider and fetch chain.",
	"author": "setwhite",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/setwhite/pi-web-search-lite.git"
	},
	"homepage": "https://github.com/setwhite/pi-web-search-lite#readme",
	"bugs": {
		"url": "https://github.com/setwhite/pi-web-search-lite/issues"
	},
	"type": "module",
	"license": "MIT",
	"packageManager": "pnpm@12.3.4",
	"engines": {
		"node": ">=22.19.0"
	},
	"files": [
		"index.ts",
		"config",
		"http",
		"ssrf",
		"providers",
		"handlers",
		"extractors",
		"tools"
	],
	"keywords": [
		"pi-package",
		"pi-extension",
		"web-search",
		"web-fetch",
		"tavily",
		"brave",
		"exa"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^1.1.0",
		"@earendil-works/pi-tui": "^1.1.0",
		"@types/node": "^26.6.4",
		"typebox": "^1.3.36",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"undici": "8.10.2"
	}
}
